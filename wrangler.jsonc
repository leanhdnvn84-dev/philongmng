// Bản dự phòng trên Cloudflare Workers (worker "philong"). Production vẫn chạy trên Vercel.
// Build + deploy: npm run cf:deploy  (cần CLOUDFLARE_API_TOKEN và CLOUDFLARE_ACCOUNT_ID)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "philong",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "philong" }],
  "observability": { "enabled": true },
  // biến/khóa nhập trong Cloudflare Dashboard được giữ nguyên mỗi lần deploy
  "keep_vars": true,
  // Sao lưu 01:00 và email cảnh báo 08:00 (giờ VN). Chỉ thực sự chạy khi biến CRON_ENABLED = "1" (xem cloudflare/worker.js).
  "triggers": { "crons": ["0 18 * * *", "0 1 * * *"] },
  // tối đa 5 phút CPU mỗi lượt (gói Workers Paid) cho sao lưu và xuất V27
  "limits": { "cpu_ms": 300000 },
  "workers_dev": true
}
