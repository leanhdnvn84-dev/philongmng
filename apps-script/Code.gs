/** Kiểm tra từng dòng file nhập. Khóa trùng: Mã khoản vay + Kỳ tháng (mỗi khoản vay 1 kỳ / tháng, giống "Tạo tháng mới"). */
function scheduleImportCheck_(ss,rows){
 const c=APP_MODULES.LICH_TRA_NO,list=Array.isArray(rows)?rows:[];if(list.length>1000)throw new Error('Mỗi lần nhập tối đa 1.000 dòng.');
