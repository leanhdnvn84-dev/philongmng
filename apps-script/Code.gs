const IMPORT_LABELS_={GOC_PHAI_TRA:'Gốc phải trả',LAI_PHAI_TRA:'Lãi phải trả',PHI_PHAI_TRA:'Phí phải trả',DIEU_CHINH_TANG_GIAM:'Điều chỉnh tăng/giảm'};
const IMPORT_FIELDS_=['MA_LICH_TRA','MA_KHOAN_VAY','KY_TRA_NO','NGAY_DEN_HAN','GOC_PHAI_TRA','LAI_PHAI_TRA','PHI_PHAI_TRA','DIEU_CHINH_TANG_GIAM','TRANG_THAI','GHI_CHU'],IMPORT_MONEY_=['GOC_PHAI_TRA','LAI_PHAI_TRA','PHI_PHAI_TRA','DIEU_CHINH_TANG_GIAM'];
function parseImportDate_(v){let s=String(v==null?'':v).trim(),m;if(!s)return'';if(/^\d{5}(\.\d+)?$/.test(s)){const d=new Date(Math.round((Number(s)-25569)*864e5));s=d.getUTCFullYear()+'-'+String(d.getUTCMonth()+1).padStart(2,'0')+'-'+String(d.getUTCDate()).padStart(2,'0');}let y,mo,da;if((m=s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/))){y=+m[1];mo=+m[2];da=+m[3];}else if((m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/))){y=+m[3];mo=+m[2];da=+m[1];}else return null;const d=new Date(y,mo-1,da);if(d.getFullYear()!==y||d.getMonth()!==mo-1||d.getDate()!==da)return null;return y+'-'+String(mo).padStart(2,'0')+'-'+String(da).padStart(2,'0');}
