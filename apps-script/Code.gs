  if(!d.KY_TRA_NO&&date)d.KY_TRA_NO=date.slice(0,7);if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(d.KY_TRA_NO))e.push('Kỳ trả nợ phải dạng YYYY-MM');else if(date&&date.slice(0,7)!==d.KY_TRA_NO)w.push('Ngày đến hạn không thuộc kỳ '+d.KY_TRA_NO);
