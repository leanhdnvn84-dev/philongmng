  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.38.0",
    "@types/qrcode": "1.5.5",
    "autoprefixer": "^10.4.14",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "next": "^14.0.0",
    "postcss": "^8.4.24",
    "qrcode": "1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.2.0",
    "vitest": "^2.1.8"
  },
  "engines": {
