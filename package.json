{
  "name": "philong-building",
  "version": "2.0.0",
  "description": "PHILONG BUILDING - quản lý vận hành tòa nhà (Next.js + Supabase), nâng cấp từ bản Google Apps Script V191",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
